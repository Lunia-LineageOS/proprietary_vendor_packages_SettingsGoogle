    <string name="face_confirmation_hide_illustration_description">עכשיו אפשר להרים את הטלפון או ללחוץ על המסך ולהשתמש בזיהוי פנים כדי לפתוח את הטלפון.</string>
    <string name="face_confirmation_info_enough_light">התכונה \"פתיחה בזיהוי פנים\" פועלת בצורה הכי טובה כשיש מספיק אור, וכשאין על הפנים שלך משקפיים כהים או מסכה.</string>
