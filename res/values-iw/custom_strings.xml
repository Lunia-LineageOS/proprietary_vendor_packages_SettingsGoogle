    <string name="security_settings_face_enroll_consent_message">כשהטלפון של הילד או הילדה מזהה את הפנים שלהם, אפשר לפתוח את נעילת הטלפון ולאמת את הזהות שלהם באפליקציות שונות</string>
    <string name="security_settings_face_enroll_consent_secure_and_helpful_message_1">‏נתוני הפנים של הילד או הילדה שלך מאוחסנים רק במכשיר ואף פעם לא נשלחים ל-Google</string>
    <string name="security_settings_face_enroll_finish_description_without_bp">עכשיו אפשר להרים את הטלפון או ללחוץ על המסך ולהשתמש בזיהוי פנים כדי לפתוח את הטלפון.\n\nפתיחה בזיהוי הפנים פועלת הכי טוב כשיש מספיק אור, וכשאין על הפנים מסכה או משקפיים כהים.</string>
    <string name="security_settings_face_enroll_finish_description_without_bp_folded">עכשיו אפשר להרים את הטלפון או ללחוץ על המסך ולהשתמש בזיהוי פנים כדי לבטל את הנעילה. כדי להשתמש בפתיחה ע\"י זיהוי הפנים, הטלפון חייב להיות מקופל.\n\nפתיחה ע\"י זיהוי הפנים פועלת בצורה הטובה ביותר כשיש מספיק אור, ללא מסכה וללא משקפיים כהים.</string>
    <string name="security_settings_face_enroll_introduction_control_consent_message_1">לך ולילד או לילדה שלך יש אפשרות להיכנס בכל שלב להגדרות ולמחוק את התבנית לזיהוי הפנים, או להשבית את התכונה \"פתיחה בזיהוי פנים\". התבניות לזיהוי הפנים נשמרות בטלפון עד שהן נמחקות.</string>
    <string name="security_settings_face_enroll_introduction_how_consent_message_1">כשמפעילים את התכונה \"פתיחה בזיהוי פנים\" המערכת יוצרת תבנית ייחודית של הפנים של הילד או הילדה כדי לאמת את הזהות שלהם. כדי ליצור את התבנית הזו במהלך ההגדרה, הילד או הילדה יצטרכו לצלם את הפנים שלהם מזוויות שונות.\n\nכשהם ישתמשו בתכונה \"פתיחה בזיהוי פנים\", המערכת תעדכן את התבנית לזיהוי הפנים בעזרת התמונות שהם צילמו. התמונות שמשמשות ליצירת התבנית לזיהוי הפנים אף פעם לא נשמרות. התבנית לזיהוי הפנים נשמרת באופן מאובטח בטלפון ואף פעם לא נשלחת או מועברת ממנו. כל פעולות העיבוד מתבצעות בטלפון באופן מאובטח.</string>
    <string name="security_settings_face_enroll_next">הבא</string>
    <string name="security_settings_face_enroll_partial_message">כדי לשפר את הביצועים, אפשר להגדיר שוב את התכונה \"פתיחה בזיהוי פנים\" בהגדרות</string>
    <string name="security_settings_face_enroll_partial_start_over">התחלה מחדש</string>
    <string name="security_settings_face_enroll_partial_title">הגדרת התכונה \"פתיחה בזיהוי פנים\" הסתיימה</string>
    <string name="security_settings_face_enroll_timeout_message">במקום זאת, כדאי לנסות את ההגדרה המהירה. חשוב לזכור: כשמשתמשים בתכונה \"פתיחה בזיהוי פנים\", צריך למקם את הראש ישירות מול הטלפון.\n\nכדי לשפר את הביצועים, אפשר להגדיר שוב את התכונה \"פתיחה בזיהוי פנים\" בהגדרות.</string>
