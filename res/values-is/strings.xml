    <!-- Default summary of the subpage of content protection settings. Will be overlaid by OEM. -->
    <string name="content_protection_preference_subpage_summary">Leit er keyrð á lokaðan hátt í tækinu og farið er yfir forritavirkni í leit að vefveiðum eða öðru sviksamlegu athæfi. Ef slíkt greinist eru tilteknar forritsupplýsingar sendar til Google Play Protect til að staðfesta ógnina og vara notendur forritsins við.</string>

