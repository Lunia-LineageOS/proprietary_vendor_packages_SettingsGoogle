<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Introduction detail message shown in face education for accessibility [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_education_message_accessibility" product="default">在下一個畫面中，請將手機舉起到視線水平</string>

    <!-- Additional details shown when the accessibility toggle is expanded. [CHAR LIMIT=NONE]-->
    <string name="security_settings_face_enroll_introduction_accessibility_expanded" product="default">使用「面孔解鎖」時，請盡量將面孔對正手機。</string>

    <!-- Introduction detail message shown in face enrollment dialog [CHAR LIMIT=NONE]-->
    <string name="security_settings_face_enroll_introduction_message" product="default">你可使用面孔解鎖手機或驗證身分，例如用來登入應用程式或核准購買交易。</string>

    <!-- Message on the face enrollment introduction page that provides information about what could cause the phone to unlock. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_looking" product="default">望著手機可能會讓手機意外解鎖。樣貌與你十分相似的人 (例如孿生兄弟姊妹) 或有人將手機拿到你的面前時，手機都可能會解鎖。</string>

    <!-- Message on the face enrollment introduction page that provides information about what could cause the phone to unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_looking" product="default">即使子女不想解鎖手機，但查看手機仍會解鎖。樣貌與子女十分相似的人 (例如孿生兄弟姊妹)，或有人將手機拿到他們面前，都可以解鎖手機。</string>

    <!-- Message on the face enrollment introduction page that provides information about the relative security of face for unlocking the phone. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_less_secure" product="default">使用複雜的上鎖圖案、PIN 或密碼，會比使用子女的面孔解鎖手機更安全</string>

    <!-- Message on the face enrollment introduction page that provides information about the relative security of face for unlocking the phone for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_less_secure" product="default">使用複雜的上鎖圖案、PIN 或密碼解鎖手機，會比使用面孔解鎖更安全。</string>

    <!-- Message on the face enrollment introduction page that provides information about how to require eyes to be open for Face Unlock. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_gaze" product="default">如果使用「面孔解鎖」功能，系統可能會要求你睜開雙眼才能解鎖手機或驗證身分。你隨時可以前往「設定」開啟此選項。</string>

    <!-- Message on the face enrollment introduction page that provides information about how to require eyes to be open for Face Unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_gaze" product="default">如果使用「面孔解鎖」功能，系統可能會要求你的子女睜開雙眼才能解鎖手機或驗證身分。你和子女隨時可以前往「設定」開啟此選項。</string>

    <!-- Message on the face enrollment introduction page that explains how face unlock works. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_how_message" product="default">「面孔解鎖」功能會建立獨一無二的面部模型以供你驗證身分時使用。如要在設定時建立此面部模型，你需要從不同角度拍攝面孔。\n\n系統會使用「面孔解鎖」時產生的圖片來更新面部模型，但不會儲存這些圖片。面部模型則會安全儲存在手機上，絕不會傳送到手機以外的地方。整個處理過程將會以安全的方式在手機上進行。</string>

    <!-- Message on the face enrollment introduction page that explains how Face Unlock works when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_how_consent_message" product="default">「面孔解鎖」功能會為子女建立獨一無二的面部模型，以便系統驗證其身分。如要在設定過程中建立此面部模型，子女需要從不同角度拍攝面孔。\n\n子女使用「面孔解鎖」時產生的圖片會作為系統更新面部模型的依據。系統不會儲存子女用來建立面部模型的圖片，只會將面部模型以安全的方式存放在手機上，但絕不會傳送到手機以外的地方。整個處理過程都會以安全的方式在手機上進行。</string>

    <!-- Message on the face enrollment introduction page that explains privacy controls for face unlock [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_control_message" product="default">你隨時可以前往「設定」刪除面部模型或停用「面孔解鎖」。面部模型會儲存在手機上，直到你刪除為止。&lt;br&gt;&lt;br&gt;詳情請參閱 &lt;a href=\'http://g.co/pixel/faceunlock\'&gt;g.co/pixel/faceunlock&lt;/a&gt;。</string>

    <!-- Message on the face enrollment introduction page that explains privacy controls for face unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_control_consent_message" product="default">你和子女隨時可以前往「設定」刪除面部模型或停用「指紋解鎖」。面部模型會儲存在手機上，直至其刪除為止。&lt;br&gt;&lt;br&gt;詳情請參閱 &lt;a href=\'http://g.co/pixel/faceunlock\'&gt;g.co/pixel/faceunlock&lt;/a&gt;。</string>

    <!-- Footer description shown on face settings page. -->
    <string name="security_settings_face_footer_description_class3" product="default">使用面孔解鎖手機或驗證身分，例如用來登入應用程式或核准購買交易。\n\n注意事項：\n你每次只可設定一張面孔。如要新增其他面孔，請刪除目前設定的面孔。\n\n只要看著手機，就可能會讓手機意外解鎖。\n\n樣貌與你十分相似的人 (例如孿生兄弟姊妹) 都有可能解鎖手機。\n</string>

    <!-- Introduction description message shown in fingerprint enrollment introduction screen in setup wizard. [CHAR LIMIT=NONE] -->
    <string name="security_settings_fingerprint_v2_enroll_introduction_footer_message_4" product="default">你隨時可以前往「設定」刪除指紋模型或停用 Pixel Imprint。指紋模型會儲存在手機上，直到你刪除為止。</string>

    <!-- Introduction description message shown in fingerprint enrollment introduction screen in setup wizard when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_fingerprint_v2_enroll_introduction_footer_message_consent_4" product="default">你和子女隨時可以前往「設定」刪除指紋模型或停用 Pixel Imprint。指紋模型會儲存在手機上，直到你或子女刪除為止。</string>

    <!-- Introduction detail message shown in fingerprint enrollment dialog, when fingerprint unlock is disabled by device admin [CHAR LIMIT=NONE]-->
    <string name="security_settings_fingerprint_enroll_introduction_message_unlock_disabled" product="default">你可以透過 Nexus Imprint 使用指紋核准購物交易或登入應用程式。\n\n任何加入的指紋均可執行這些操作，因此請審慎決定要加入的指紋。\n\n注意事項：你無法使用指紋解鎖此裝置。如需瞭解詳情，請聯絡你機構的管理員。</string>

    <!-- Summary for the smart battery toggle [CHAR LIMIT=NONE] -->
    <string name="smart_battery_summary" product="default">「自動調節電池用量」功能可根據手機使用情況，持續調整各應用程式的用電量。為延長電池壽命，系統可能會降低效能及延遲通知。</string>
    <string name="smart_battery_summary" product="tablet">「自動調節電池用量」功能可根據平板電腦使用情況，持續調整各應用程式的用電量。為延長電池壽命，系統可能會降低效能及延遲通知。</string>

    <!-- Title for Display settings [CHAR LIMIT=30] -->
    <string name="display_settings" product="default">顯示及觸控</string>

    <!-- Introduction title shown in face enrollment when when asking for parental consent for the face unlock feature [CHAR LIMIT=40] -->
    <string name="security_settings_face_enroll_consent_introduction_title" product="default">允許使用「面孔解鎖」</string>

    <!-- Introduction title shown in face enrollment to introduce the face unlock feature [CHAR LIMIT=40] -->
    <string name="security_settings_face_enroll_introduction_title" product="default">設定「面孔解鎖」</string>

    <!-- Footer learn more description shown on face settings page. -->
    <string name="security_settings_face_footer_learn_more_description" product="default">進一步瞭解「面孔解鎖」</string>

    <!-- Description shown for fingerprint settings page. [CHAR LIMIT=22] -->
    <string name="security_settings_fingerprint_description" product="default">建議將「面孔解鎖」設定為備用解鎖方式，在手指有水或天氣寒冷時解鎖裝置會更方便。\n\n你的指紋只儲存在裝置上，絕不會傳送給 Google。</string>
</resources>
