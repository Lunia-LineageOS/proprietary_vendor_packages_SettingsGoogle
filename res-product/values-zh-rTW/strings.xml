<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Introduction detail message shown in face education for accessibility [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_education_message_accessibility" product="default">在下一個畫面，請將手機舉到眼睛高度</string>

    <!-- Additional details shown when the accessibility toggle is expanded. [CHAR LIMIT=NONE]-->
    <string name="security_settings_face_enroll_introduction_accessibility_expanded" product="default">使用人臉解鎖功能時，請盡量將臉正對手機。</string>

    <!-- Introduction detail message shown in face enrollment dialog [CHAR LIMIT=NONE]-->
    <string name="security_settings_face_enroll_introduction_message" product="default">你可以使用臉孔解鎖手機或驗證身分，方便你登入應用程式、核准購物交易或其他用途。</string>

    <!-- Message on the face enrollment introduction page that provides information about what could cause the phone to unlock. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_looking" product="default">看著手機時，可能會意外解鎖。如果有人跟你長得很像 (例如孿生兄弟姐妹)，或將手機拿到你面前，都有可能會解鎖手機。</string>

    <!-- Message on the face enrollment introduction page that provides information about what could cause the phone to unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_looking" product="default">看著手機時，可能會意外解鎖手機。長相與你孩子十分相似的人 (例如孿生兄弟姐妹)，或有人將手機拿到孩子的面前，都有可能會將手機解鎖。</string>

    <!-- Message on the face enrollment introduction page that provides information about the relative security of face for unlocking the phone. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_less_secure" product="default">使用複雜的圖案、PIN 碼或密碼解鎖手機可能比使用孩子的臉孔解鎖來得安全</string>

    <!-- Message on the face enrollment introduction page that provides information about the relative security of face for unlocking the phone for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_less_secure" product="default">使用複雜的圖案、PIN 碼或密碼解鎖手機可能比使用人臉解鎖來得安全</string>

    <!-- Message on the face enrollment introduction page that provides information about how to require eyes to be open for Face Unlock. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_gaze" product="default">如果使用人臉解鎖功能，系統可能會要求你必須睜開雙眼才能解鎖手機或驗證身分。你隨時可以前往「設定」開啟這個選項。</string>

    <!-- Message on the face enrollment introduction page that provides information about how to require eyes to be open for Face Unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_consent_gaze" product="default">如果使用人臉解鎖功能，系統可能會要求孩子必須睜開雙眼才能解鎖手機或驗證身分。你和孩子隨時可以前往「設定」開啟這個選項。</string>

    <!-- Message on the face enrollment introduction page that explains how face unlock works. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_how_message" product="default">人臉解鎖功能會建立你專屬的臉部模型，用來驗證你的身分。在設定期間，你必須拍攝臉部的各個角度，才能建立臉部模型。\n\n你使用人臉解鎖功能時產生的圖像，會做為系統更新臉部模型的依據。系統不會儲存建立臉部模型時使用的圖像，只會將臉部模型安全存放在手機上，而且絕對不會外洩。整個處理過程都是在你的手機上進行，安全有保障。</string>

    <!-- Message on the face enrollment introduction page that explains how Face Unlock works when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_how_consent_message" product="default">人臉解鎖功能會建立孩子的專屬臉部模型，用來驗證孩子的身分。在設定期間，孩子必須拍攝臉部的各個角度，才能建立這個臉部模型。\n\n孩子使用人臉解鎖功能時產生的圖像會做為系統更新臉部模型的依據。系統不會儲存孩子在建立臉部模型時使用的圖像，只會將臉部模型安全儲存在手機上，而且絕對不會傳送至他處。整個處理過程都是在手機上進行，安全有保障。</string>

    <!-- Message on the face enrollment introduction page that explains privacy controls for face unlock [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_control_message" product="default">你隨時可以前往「設定」刪除臉部模型或關閉人臉解鎖功能。臉部模型會儲存在手機上，直到你刪除為止。&lt;br&gt;&lt;br&gt;如要瞭解詳情，請前往 &lt;a href=\'http://g.co/pixel/faceunlock\'&gt;g.co/pixel/faceunlock&lt;/a&gt;。</string>

    <!-- Message on the face enrollment introduction page that explains privacy controls for face unlock when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_control_consent_message" product="default">你和孩子隨時可以前往「設定」刪除臉部模型或關閉人臉解鎖功能。臉部模型會儲存在手機上，直到你或孩子刪除為止。&lt;br&gt;&lt;br&gt;詳情請參閱 &lt;a href=\'http://g.co/pixel/faceunlock\'&gt;g.co/pixel/faceunlock&lt;/a&gt;。</string>

    <!-- Footer description shown on face settings page. -->
    <string name="security_settings_face_footer_description_class3" product="default">你可以用臉孔解鎖手機或驗證身分，以登入應用程式、核准購買交易等。\n\n注意事項：\n一次只能設定一張臉孔。如要新增其他臉孔，請刪除目前設定的臉孔。\n\n看著手機時，可能會讓手機意外解鎖。\n\n長相與你很相似的人 (例如孿生兄弟姐妹) 或許可以解鎖你的手機。\n</string>

    <!-- Introduction description message shown in fingerprint enrollment introduction screen in setup wizard. [CHAR LIMIT=NONE] -->
    <string name="security_settings_fingerprint_v2_enroll_introduction_footer_message_4" product="default">你隨時可以前往「設定」刪除指紋模型或關閉 Pixel Imprint。指紋模型會儲存在手機上，直到你刪除為止。</string>

    <!-- Introduction description message shown in fingerprint enrollment introduction screen in setup wizard when asking for parental consent. [CHAR LIMIT=NONE] -->
    <string name="security_settings_fingerprint_v2_enroll_introduction_footer_message_consent_4" product="default">你和孩子隨時可以前往「設定」刪除指紋模型或關閉 Pixel Imprint。指紋模型會儲存在手機上，直到你或孩子刪除為止。</string>

    <!-- Introduction detail message shown in fingerprint enrollment dialog, when fingerprint unlock is disabled by device admin [CHAR LIMIT=NONE]-->
    <string name="security_settings_fingerprint_enroll_introduction_message_unlock_disabled" product="default">你可以使用 Nexus Imprint 的指紋功能，授權購物交易或登入應用程式。\n\n你在裝置上新增的任何指紋都能用來進行前述操作，因此請慎選要加入的指紋。\n\n注意：這部裝置無法使用指紋來解鎖，詳情請洽貴機構的管理員。</string>

    <!-- Summary for the smart battery toggle [CHAR LIMIT=NONE] -->
    <string name="smart_battery_summary" product="default">「自動調節電池用量」功能可根據手機使用情形，持續調整各應用程式的用電量。為延長電池續航力，系統可能會降低效能及延遲通知。</string>
    <string name="smart_battery_summary" product="tablet">「自動調節電池用量」功能可根據平板電腦使用情形，持續調整各應用程式的用電量。為延長電池續航力，系統可能會降低效能及延遲通知。</string>

    <!-- Title for Display settings [CHAR LIMIT=30] -->
    <string name="display_settings" product="default">顯示和觸控</string>

    <!-- Introduction title shown in face enrollment when when asking for parental consent for the face unlock feature [CHAR LIMIT=40] -->
    <string name="security_settings_face_enroll_consent_introduction_title" product="default">允許使用「人臉解鎖」</string>

    <!-- Introduction title shown in face enrollment to introduce the face unlock feature [CHAR LIMIT=40] -->
    <string name="security_settings_face_enroll_introduction_title" product="default">設定「人臉解鎖」</string>

    <!-- Footer learn more description shown on face settings page. -->
    <string name="security_settings_face_footer_learn_more_description" product="default">進一步瞭解「人臉解鎖」</string>

    <!-- Description shown for fingerprint settings page. [CHAR LIMIT=22] -->
    <string name="security_settings_fingerprint_description" product="default">建議將「人臉解鎖」設為備用解鎖方式，在手指冰冷或濕掉時解鎖裝置會更方便。\n\n指紋資料只會儲存在裝置上，絕對不會傳送給 Google。</string>
</resources>
