android_library {
    name: "SettingsGoogle-core",
    defaults: ["SettingsLib-search-defaults"],
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "src/**/*.aidl",
    ],
    use_resource_processor: true,
    resource_dirs: [
        "res",
        "res-product",
    ],
    static_libs: [
        "BiometricsCommonLib",
        "Settings-core",
        "SettingsGoogle-SimpleMode",
        "androidx.compose.runtime_runtime",
        "columbus-lib",
        "com.google.hardware.biometrics.sidefps.fingerprint-ext-V1-java",
        "googlebattery-lib",
        "reversecharging-lib",
    ],
    javacflags: [
        "-Acom.android.settingslib.search.processor.package=com.google.android.settings.search",
    ],
    manifest: "AndroidManifest-res.xml",
}

android_app {
    name: "SettingsGoogle",
    defaults: [
        "platform_app_defaults",
        "Settings_optimized_defaults",
    ],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    required: [
        "privapp_whitelist_com.android.settings",
        "settings-platform-compat-config",
    ],
    static_libs: [
        "SettingsGoogle-GeneralAccess",
        // Stock links only the sensor library of the device; Lunia builds one APK for all of them.
        "SFPSLib",
        "UDFPSLib",
    ],
    resource_dirs: [],
    use_resource_processor: true,
    uses_libs: ["org.apache.http.legacy"],
    overrides: [
        "Settings",
    ],
}
